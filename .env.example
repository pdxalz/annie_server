# Copy to .env (never commit .env). Used by docker compose.
MQTT_HOST=mosquitto-broker
MQTT_PORT=1883
MQTT_USRNM=web_api
MQTT_PSWD=change-me
# Contact address NWS asks API clients to include in the User-Agent
NWS_USER_AGENT=(sauviewind.net, you@example.com)
# Set to 0 to switch a feature off (useful for local testing)
MQTT_ENABLED=1
COLLECTORS_ENABLED=1
